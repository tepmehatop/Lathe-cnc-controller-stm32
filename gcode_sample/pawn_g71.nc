O0100 (SHAHMATNAYA PESHKA)
(--- ПОДГОТОВКА И БЕЗОПАСНОСТЬ ---)
G18 G21 G40 G99        (Выбор плоскости XZ, мм, отмена коррекции, подача мм/об)
G50 S2500              (Ограничение максимальных оборотов шпинделя)
G28 U0 W0              (Выход в референтную точку)

(--- ИНСТРУМЕНТ И РЕЖИМЫ РЕЗАНИЯ ---)
T0101                  (Выбор резца №1 и корректора №1)
G96 S180 M03           (Постоянная скорость резания 180 м/мин, запуск шпинделя)
M08                    (Включение охлаждения)

(--- ПОДХОД К ЗАГОТОВКЕ ---)
G00 X32.0 Z2.0         (Быстрый подрез к безопасной точке перед торцом)

(--- ЦИКЛ ЧЕРНОВОЙ ОБДИРКИ G71 ---)
(U1.5 - глубина съема на сторону 1.5 мм, R1.0 - величина отскока резца)
G71 U1.5 R1.0
(P10 - начальный кадр контура, Q20 - конечный кадр контура)
(U0.5 - припуск под чистовую по оси X, W0.1 - припуск под чистовую по оси Z, F0.2 - подача)
G71 P10 Q20 U0.5 W0.1 F0.2

(--- ОПИСАНИЕ ЧИСТОВОГО КОНТУРА ПЕШКИ ---)
N10 G00 X0.0           (Быстрый ход на центр детали)
G01 Z0.0 F0.1          (Касание торца)
G03 X12.0 Z-6.0 R6.0   (Сфера - головка пешки, дуга против час. стрелки)
G01 Z-9.0              (Шейка детали)
G02 X20.0 Z-22.0 R15.0 (Плавное расширение к юбке)
G01 X24.0              (Ступенька основания)
G01 Z-24.0             (Цилиндрический поясок основания)
G02 X28.0 Z-28.0 R4.0  (Нижний радиус основания)
G01 Z-45.0             (Проход по телу до конца отрезки)
X32.0                  (Выход резца вверх от детали)
N20 G00 Z2.0           (Отвод инструмента по Z на безопасное расстояние)

(--- ЦИКЛ ЧИСТОВОЙ ОБРАБОТКИ G70 ---)
G96 S220 M03           (Увеличение скорости для лучшей чистоты поверхности)
G70 P10 Q20 F0.08      (Чистовой проход по ранее заданному контуру с меньшей подачей)

(--- ЗАВЕРШЕНИЕ ПРОГРАММЫ ---)
M09                    (Выключение СОЖ)
G28 U0 W0              (Возврат в нулевую точку станка)
